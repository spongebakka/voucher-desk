{
  "manifest_version": 3,
  "name": "Voucher Desk itison helper",
  "version": "2.8",
  "description": "Fills in the code and PIN on the itison Hub, tells Voucher Desk when a voucher is redeemed, and fetches itison's deal lists for the end of shift check.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://*.netlify.app/*",
    "https://itison.com/*",
    "https://www.itison.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://itison.com/hub/*",
        "https://www.itison.com/hub/*"
      ],
      "js": [
        "itison.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.netlify.app/*"
      ],
      "js": [
        "desk.js"
      ],
      "run_at": "document_start"
    }
  ]
}
